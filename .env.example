# The repository defaults to the deterministic offline contract-test provider.
# Export these variables via your shell/IDE; .env is not auto-loaded.
LLM_PROVIDER=mock

# Configure these only for an approved OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# Optional isolated workspace database; normally leave unset.
# WORKSPACE_AUDIT_DB=artifacts/my_demo.sqlite3
