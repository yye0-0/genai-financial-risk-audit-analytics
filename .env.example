# Offline default: LLM_PROVIDER=mock
#
# DeepSeek hosted API configuration. Copy this file to `.env`, then replace
# the placeholder with a key created in the DeepSeek platform. Never commit it.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_deepseek_api_key
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
